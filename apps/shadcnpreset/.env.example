# Canonical absolute origin for metadata, robots, and sitemaps (no trailing slash).
# Prefer this when the production hostname differs from VERCEL_PROJECT_PRODUCTION_URL (e.g. custom domain).
# NEXT_PUBLIC_SITE_URL=https://example.com

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME
# Optional: override Postgres connection fingerprint shown in pg_stat_activity.application_name.
# DB_APPLICATION_NAME=shadcnpreset-web
# Optional pool tuning (helps serverless workloads release idle DB sessions faster):
# PG_POOL_MAX=2
# PG_IDLE_TIMEOUT_MS=5000
# PG_CONNECTION_TIMEOUT_MS=5000
BETTER_AUTH_URL=http://localhost:4010
BETTER_AUTH_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:4010
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

# Smart search: OPENAI_API_KEY enables query embedding vs precomputed preset vectors.
# Generate vectors once: `pnpm generate:preset-embeddings` (writes data/preset-embeddings.json).
OPENAI_API_KEY=
# /assistant guided chat (structured turns). Defaults to gpt-4o-mini if unset.
# OPENAI_ASSISTANT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Shared secret for the cron refresh endpoint.
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
# Local-only escape hatch: bypass snapshot-first reads and query DB directly
# (still falls back deterministically if DB fails).
# LOCAL_DISABLE_COMMUNITY_SNAPSHOT=1

# Optional: only first N codes on /high-contrast-presets (build-time; redeploy after changing).
# HIGH_CONTRAST_PRESET_LIMIT=100
